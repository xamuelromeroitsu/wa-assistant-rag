# ---- Base de datos (PostgreSQL + pgvector) ----
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu_password_segura
PGDATABASE=wa_assistant

# ---- Modelo de IA (Ollama) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# ---- Timeouts de Ollama en ms (valores por defecto entre paréntesis) ----
# Subí OLLAMA_GENERATE_TIMEOUT_MS si tu máquina genera en CPU y tarda más de 30 s.
OLLAMA_GENERATE_TIMEOUT_MS=30000
OLLAMA_EMBEDDINGS_TIMEOUT_MS=15000
OLLAMA_TAGS_TIMEOUT_MS=5000

# ---- Servidor interno ----
PORT=3000

# ---- RAG ----
TOP_K=5

# ---- Logging ----
LOG_LEVEL=DEBUG

# ---- WhatsApp (opcional, solo referencia) ----
# WABA_BOT_NUMBER=