{
  "name": "wa-assistant-rag",
  "version": "0.0.1",
  "description": "Asistente de WhatsApp con RAG: PostgreSQL + pgvector y Ollama",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "ingest": "node src/rag/ingest.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "pdf-parse": "^2.4.5",
    "pg": "8.23.1",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "vitest": "^4.1.11"
  }
}
